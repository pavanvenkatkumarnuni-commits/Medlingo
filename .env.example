# --- Server ---
HOST=0.0.0.0
PORT=8000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite:///./data/medlingo.db

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- AI provider (for medical explanation + translation) ---
# Supported: "anthropic" | "none"
# With AI_PROVIDER=none, the app still runs and performs rule-based term
# extraction (medicine/dosage/frequency/duration patterns), but will not
# fabricate explanations or translations — it will clearly say the AI
# explanation/translation is unavailable until a provider is configured.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OCR ---
# Path to the tesseract binary. Leave as "tesseract" if it's on PATH.
TESSERACT_CMD=tesseract
